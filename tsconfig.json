{
	"include": ["src/**/*.ts", "example/**/*.mjs"],
	"compilerOptions": {
		"target": "es2021",
		"lib": ["es2021"],
		"module": "node16",
		"moduleResolution": "node16",
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"outDir": "dist",
		"declaration": true,
		"declarationDir": "types",
		"sourceMap": true,
		"noImplicitAny": true,
		"noImplicitOverride": true,
		"forceConsistentCasingInFileNames": true,
		"checkJs": true,
		"paths": {
			"esmakefile": ["./src"]
		}
	}
}
